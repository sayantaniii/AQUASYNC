PORT=5000

# Get this from your local PostgreSQL install (or Neon/Supabase/Railway later)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aquasync

# Generate a real random string for this (see README step 6)
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

NODE_ENV=development
